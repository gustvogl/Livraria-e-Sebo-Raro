{
  "name": "livraria-rara-aluno-11",
  "version": "1.2.0",
  "private": true,
  "description": "Aluno 11 — Livraria e Sebo Raro — React e Capacitor Camera",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:build": "node scripts/build-apk.mjs",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/camera": "6.1.3",
    "@capacitor/core": "6.2.2",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@ionic/pwa-elements": "3.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.1"
  }
}
